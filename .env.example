# Copiar únicamente valores de un proyecto NUEVO para El Viejo. Nunca subir .env.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Tres puertas independientes: ninguna integración real se activa por defecto.
BOT_ENABLED=false
WHATSAPP_SEND_ENABLED=false
AI_IMAGE_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
META_APP_SECRET=
WORKER_SECRET=
# API Responses de OpenAI o proveedor compatible; HTTPS obligatorio.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
# También se aceptan las variables OPENAI_API_KEY, OPENAI_MODEL,
# OPENAI_VISION_MODEL del upstream; no hacen falta si se usan AI_*.
